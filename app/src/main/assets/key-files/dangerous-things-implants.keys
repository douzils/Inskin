# Clés communes pour implants Dangerous Things xM1 (Mifare Classic)
# Format MCT compatible - 12 caractères hex par ligne

# Clés par défaut Mifare
FFFFFFFFFFFF  # Default key A/B (la plus commune)
A0A1A2A3A4A5  # Default MAD key
D3F7D3F7D3F7  # Default transport key

# Clés communes pour implants DT xM1
000000000000  # All zeros
111111111111  # All ones
123456789ABC  # Sequential
AABBCCDDEEFF  # Sequential pairs

# Clés trouvées sur des systèmes de contrôle d'accès
A0B0C0D0E0F0
A1B1C1D1E1F1
4D3A99C351DD
1A982C7E459A
AABBCCDD0001
AABBCCDD0002

# Clés spécifiques Dangerous Things (souvent utilisées pour tests)
DEADBEEF0000
CAFEBABE0000
48454C4C4F00  # "HELLO" en ASCII

# Clés du dictionnaire étendu MCT
714C5C886E97
587EE5F9350F
A0478CC39091
533CB6C723F6
8FD0A4F256E9

# Clés trouvées sur badges commerciaux
B0B1B2B3B4B5
C0C1C2C3C4C5
D0D1D2D3D4D5
E0E1E2E3E4E5

# Clés pour systèmes de transport (souvent clonés dans xM1)
FC00018778F7  # Navigo (Paris)
A0A1A2A3A4A5  # Transport key
MAD_KEY_A = A0A1A2A3A4A5
MAD_KEY_B = D3F7D3F7D3F7

